{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "lsp": {
    "biome": {
      "command": ["node", "node_modules/@biomejs/biome/bin/biome", "lsp-proxy", "--stdio"],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts",
        ".json",
        ".jsonc",
        ".css",
        ".scss",
        ".html"
      ]
    }
  }
}
